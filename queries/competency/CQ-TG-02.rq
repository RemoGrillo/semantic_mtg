# id: CQ-TG-02
# title: Tags with several parents
# question: Which tags have more than one Tagger parent?
# kind: SPARQL
# expects: nonempty
# modules: tags
PREFIX smtg: <https://w3id.org/smtg/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX v: <https://w3id.org/smtg/vocab/>
SELECT ?tag (COUNT(?parent) AS ?parents) (GROUP_CONCAT(?pl; separator=', ') AS ?parentLabels) WHERE {
  ?t smtg:taggerParent ?parent ; skos:prefLabel ?tag . OPTIONAL { ?parent skos:prefLabel ?pl }
} GROUP BY ?tag HAVING (COUNT(?parent) > 1) ORDER BY DESC(?parents) ?tag
