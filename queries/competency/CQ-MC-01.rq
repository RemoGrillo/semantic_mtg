# id: CQ-MC-01
# title: No mana cost versus zero mana cost
# question: Which faces have no mana cost at all, and which have a cost of exactly {0}?
# kind: SPARQL
# expects: nonempty
# modules: cards
# note: absence of a cost triple would mean 'unknown'; both cases are explicit (AP-05): [[Ancestral Vision]] has no mana cost, [[Ornithopter]] costs {0}.
PREFIX smtg: <https://w3id.org/smtg/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX v: <https://w3id.org/smtg/vocab/>
SELECT ?faceName ?kind WHERE {
  { ?f smtg:hasNoManaCost true ; smtg:name ?faceName . BIND("no mana cost" AS ?kind) }
  UNION
  { ?f smtg:hasManaCost/smtg:manaCostNotation "{0}" ; smtg:name ?faceName . BIND("cost {0}" AS ?kind) }
} ORDER BY ?kind ?faceName
