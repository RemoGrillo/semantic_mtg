# id: CQ-TG-05
# title: Negative test — art tags only on illustrations
# question: Is any art tag assigned to something other than an illustration?
# kind: negative
# expects: empty
# modules: tags
PREFIX smtg: <https://w3id.org/smtg/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX v: <https://w3id.org/smtg/vocab/>
SELECT ?a ?target WHERE {
  ?a a smtg:ArtTagAssignment ; smtg:assignmentTarget ?target . FILTER NOT EXISTS { ?target a smtg:Illustration }
}
