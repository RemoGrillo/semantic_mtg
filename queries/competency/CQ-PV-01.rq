# id: CQ-PV-01
# title: Claims by kind, authority and source
# question: How many claims of each kind exist, with which epistemic status, from which source dataset?
# kind: SPARQL
# expects: nonempty
# modules: claims, provenance
# note: documented combos, tag beliefs, authoritative legality reports and statistical observations stay distinguishable.
PREFIX smtg: <https://w3id.org/smtg/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX v: <https://w3id.org/smtg/vocab/>
SELECT ?claimClass ?status ?dataset (COUNT(?c) AS ?n) WHERE {
  ?c a ?cls ; smtg:hasEpistemicStatus/skos:notation ?status ; smtg:observedIn/smtg:snapshotOf/rdfs:label ?dataset .
  ?cls rdfs:subClassOf* smtg:Claim ; rdfs:label ?claimClass .
  FILTER NOT EXISTS { ?c a ?sub . ?sub rdfs:subClassOf ?cls . FILTER(?sub != ?cls) }
} GROUP BY ?claimClass ?status ?dataset ORDER BY DESC(?n)
