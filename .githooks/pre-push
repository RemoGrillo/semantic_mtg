#!/bin/sh
# Runs before every `git push` once enabled with `npm run hooks:install` (git config core.hooksPath .githooks).
# Runs what CI and the GitHub Pages workflow run (see tools/check.mjs); a failure blocks the push.
# Skip once with `git push --no-verify`; disable with `git config --unset core.hooksPath`.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: npm run check (skip once with git push --no-verify)"
exec npm run -s check
