# -----------------------------------------------------------------------------
#  Which face counts where; permanents (added 2026-11-03, model review)
# -----------------------------------------------------------------------------

smtg:primaryFace a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:subPropertyOf smtg:hasFace ;
  rdfs:label "primary face"@en ;
  skos:definition "The face whose characteristics the card has outside the battlefield and the stack: the front face of a double-faced card (CR 712.8a), the normal characteristics of an adventurer (CR 715.4), flip (CR 710.1) or preparation card (CR 722.2), and the only face of a single-faced card. Split cards have none: their characteristics are those of both halves combined (CR 709.4)."@en ;
  skos:scopeNote "Derived per layout by a documented mapping (each Layout concept states smtg:primaryFacePolicy). This is what \"is this a permanent card in my hand?\" depends on."@en ;
  rdfs:domain smtg:OracleCard ; rdfs:range smtg:CardFace ;
  smtg:sourceField "scryfall:card_faces[]" , "scryfall:layout" ;
  smtg:docExample <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902> ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:PermanentFace a owl:Class ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( smtg:CardFace [ a owl:Restriction ; owl:onProperty smtg:hasCardType ; owl:someValuesFrom smtg:PermanentCardType ] ) ] ;
  rdfs:label "Permanent face"@en ;
  skos:definition "A card face with at least one permanent card type: artifact, battle, creature, enchantment, land or planeswalker (CR 110.4)."@en ;
  skos:scopeNote "Defined at face level because 287 Oracle cards (2026-11-03) have one permanent face and one instant or sorcery face (adventures, some MDFCs). Not disjoint with InstantOrSorceryFace: three Un-cards are typed, e.g., \"Instant Creature\"."@en ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:InstantOrSorceryFace a owl:Class ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( smtg:CardFace [ a owl:Restriction ; owl:onProperty smtg:hasCardType ; owl:someValuesFrom smtg:InstantOrSorceryCardType ] ) ] ;
  rdfs:label "Instant or sorcery face"@en ;
  skos:definition "A card face with the instant or sorcery card type; such a card can't enter the battlefield (CR 110.4)."@en ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:PermanentCard a owl:Class ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( smtg:OracleCard [ a owl:Class ; owl:unionOf (
      [ a owl:Restriction ; owl:onProperty smtg:primaryFace ; owl:someValuesFrom smtg:PermanentFace ]
      [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty smtg:hasLayout ; owl:hasValue <https://w3id.org/smtg/vocab/layout/split> ] [ a owl:Restriction ; owl:onProperty smtg:hasFace ; owl:someValuesFrom smtg:PermanentFace ] ) ] ) ] ) ] ;
  rdfs:label "Permanent card"@en ;
  skos:definition "An Oracle card that is a \"permanent card\" in the sense of CR 110.4a (an artifact, battle, creature, enchantment, land or planeswalker card) in zones other than the battlefield and the stack: its primary face is a permanent face, or it is a split card one of whose halves is (the halves' characteristics combine, CR 709.4)."@en ;
  skos:scopeNote "A modal double-faced card such as Agadeem's Awakening // Agadeem, the Undercrypt is not a permanent card in hand (its front face is a sorcery), even though it can be played as a land via its back face."@en ;
  skos:example "[[Bonecrusher Giant // Stomp]] is a permanent card (its primary face is a creature); [[Agadeem's Awakening // Agadeem, the Undercrypt]] is not; the split card [[Fire // Ice]] is not either (both halves are instants)."@en ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:createsToken a owl:ObjectProperty ;
  rdfs:label "creates token"@en ;
  skos:definition "Projection: the Oracle card is related by the source to a token it can create (Scryfall all_parts with component \"token\")."@en ;
  skos:scopeNote "Lossy projection of smtg:PartRelationship (role token), materialised by rule R-TOKEN (rules/). Scryfall's token links are curated, mostly mean \"can create\", and are not guaranteed exhaustive."@en ;
  smtg:projectionOf smtg:PartRelationship ;
  smtg:inferenceRule "R-TOKEN" ;
  rdfs:domain smtg:OracleCard ; rdfs:range smtg:OracleCard ;
  smtg:sourceField "scryfall:all_parts[].component" ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:producesManaViaToken a owl:ObjectProperty ;
  owl:propertyChainAxiom ( smtg:createsToken smtg:producesManaSymbol ) ;
  rdfs:label "produces mana via token"@en ;
  skos:definition "Inferred: the card can create a token that can produce this kind of mana (e.g. Eldrazi Confluence → Eldrazi Scion → {C})."@en ;
  skos:scopeNote "Defined by the property chain createsToken ∘ producesManaSymbol and materialised by rule R-MANA-VIA-TOKEN into the inferred graph, never into source graphs. Conditional (the token must be created) and only as complete as Scryfall's token links and produced_mana."@en ;
  smtg:inferenceRule "R-MANA-VIA-TOKEN" ;
  skos:example "[[Eldrazi Confluence]] can create [[Eldrazi Scion]] tokens, which can sacrifice themselves for {C}: so Eldrazi Confluence producesManaViaToken {C}. [[!Eldrazi Confluence]] [[!Eldrazi Scion]]"@en ;
  rdfs:domain smtg:OracleCard ; rdfs:range smtg:ManaSymbol ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

smtg:faceKeyword a owl:ObjectProperty ;
  rdfs:label "face keyword"@en ;
  skos:definition "A keyword that belongs to a specific face. Derived by normalisation from the card-level keyword list: on single-faced cards every keyword; on multi-faced cards the keywords whose name occurs in that face's Oracle text."@en ;
  skos:scopeNote "Scryfall gives keywords only per card; 717 multi-face Oracle cards (2026-11-03) have keywords without saying which face. Keywords matched on no face stay only on the card (smtg:hasKeyword)."@en ;
  rdfs:domain smtg:CardFace ; rdfs:range smtg:Keyword ;
  smtg:sourceField "scryfall:keywords" , "scryfall:card_faces[].oracle_text" ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "unstable" .

