  skos:scopeNote "Lexical value always kept; smtg:powerValue only when it is a plain number. \"*\" is not a malformed integer."@en ;
  rdfs:domain smtg:CardFace ; rdfs:range xsd:string ;
  smtg:sourceField "scryfall:power" , "scryfall:card_faces[].power" ;
  smtg:reviewQuestion "RQ-CF-2" ;
  rdfs:isDefinedBy smtgm:cards ; vs:term_status "stable-draft" .

smtg:powerValue a owl:DatatypeProperty , owl:FunctionalProperty ;
