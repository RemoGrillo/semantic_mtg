<https://w3id.org/smtg/vocab/layout/reversible_card>
  a smtg:Layout ;
  skos:inScheme <https://w3id.org/smtg/vocab/layout> ;
  skos:prefLabel "Reversible card"@en ;
  rdfs:label "Reversible card"@en ;
  skos:notation "reversible_card" ;
  skos:definition "A printing showing the same Oracle card on both sides, with different artwork (e.g. alternative-art Secret Lair). Scryfall puts the Oracle ID on each face instead of on the card; in all 83 reversible printings of the 2026-11-03 snapshot the two are the same. A printing convention, not a game layout."@en ;
  smtg:sourceValueOf "scryfall:layout" ;
  smtg:observedCount 83 ;
  rdfs:isDefinedBy smtgm:vocab ;
  smtg:impliesFaceConfiguration <https://w3id.org/smtg/vocab/face-configuration/double-sided-same-card> ;
  smtg:impliesObjectKind <https://w3id.org/smtg/vocab/object-kind/traditional-card> ;
  smtg:faceCount "1, printed on each side" ;
  smtg:physicalSides "2" ;
  smtg:faceArrangement "the same card on each side, different artwork"@en ;
  smtg:separateOracleIdentity "no: the same Oracle ID on both faces" ;
  skos:example "[[Jinnie Fay, Jetmir's Second|SLD|1556]] [[!Jinnie Fay, Jetmir's Second|SLD|1556]]"@en ;
  smtg:primaryFacePolicy "printing layout: each side is its own Oracle card"@en ;
  skos:scopeNote "Printing convention: recorded with smtg:printingLayout on the printing; the Oracle card keeps its game layout."@en .

