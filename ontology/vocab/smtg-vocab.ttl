  rdfs:label "Party"@en ;
  skos:prefLabel "Party"@en ;
  skos:definition "Some cards refer to a player’s party. A player’s party consists of up to one Cleric creature that player controls, up to one Rogue creature they control, up to one Warrior creature they control, and up to one Wizard creature they control."@en ;
  skos:member <https://w3id.org/smtg/vocab/creature-type/cleric> ;
  skos:member <https://w3id.org/smtg/vocab/creature-type/rogue> ;
