    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/2f5f46ed-b8aa-4864-bd20-17281d4632bf/7dedc20b6eba> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/2f5f46ed-b8aa-4864-bd20-17281d4632bf>;
    smtg:rulingText "Preparation cards can only be cast with their base characteristics.";
    smtg:publishedOn "2026-03-20"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
