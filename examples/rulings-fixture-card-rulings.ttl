    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "Protection prevents damage, so protection will be unable to prevent damage after Stomp has resolved. However, this won't allow a spell or ability to target illegally, even if that spell or ability would cause damage to be dealt.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
