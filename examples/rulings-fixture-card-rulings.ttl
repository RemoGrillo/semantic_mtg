    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/8faa4330-07bb-4b65-810a-bbce29d3cd42/81100f8de667> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/8faa4330-07bb-4b65-810a-bbce29d3cd42>;
    smtg:rulingText "If the copied permanent is a token, the token that's created copies the original characteristics of that token as stated by the effect that created that token.";
    smtg:publishedOn "2023-04-14"^^xsd:date;
