    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If you cast an adventurer card as an Adventure, use only its alternative characteristics to determine whether it's legal to cast that spell. For example, if Giant Killer is exiled with the last ability of Vivien, Champion of the Wilds, you can't cast it as Chop Down.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
