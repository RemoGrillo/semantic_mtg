<https://w3id.org/smtg/id/claim/ruling/8faa4330-07bb-4b65-810a-bbce29d3cd42/e2113180c4b7> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/8faa4330-07bb-4b65-810a-bbce29d3cd42>;
    smtg:rulingText "As a Siege enters the battlefield, its controller chooses an opponent to be its protector.";
    smtg:publishedOn "2023-04-14"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
