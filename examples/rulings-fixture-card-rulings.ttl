    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/01160cb5-6d83-4317-9522-74083b3a83bb>;
    smtg:rulingText "If a Confluence is copied, the effect that creates the copy will usually allow you to choose new targets, but you can't choose new modes.";
    smtg:publishedOn "2024-06-07"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
