<https://w3id.org/smtg/id/claim/ruling/310f141c-7f37-4729-aed6-dd9c09db448d/faed5ba1ab68> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/310f141c-7f37-4729-aed6-dd9c09db448d>;
    smtg:rulingText "If Blood Artist and one or more other creatures die at the same time, its ability will trigger for each of those creatures.";
    smtg:publishedOn "2016-06-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
