    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/2f5f46ed-b8aa-4864-bd20-17281d4632bf/823e68665463> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/2f5f46ed-b8aa-4864-bd20-17281d4632bf>;
    smtg:rulingText "While copies of spells in zones other than the stack cease to exist when state-based actions are checked, this does not apply to copies of prepare spells in exile that were created as a creature became prepared.";
    smtg:publishedOn "2026-03-20"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
