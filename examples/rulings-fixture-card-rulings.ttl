    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "Stomp only stops damage from being prevented by effects that specifically use the word \"prevent.\"";
