    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/8faa4330-07bb-4b65-810a-bbce29d3cd42/bb8c14e3e064> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/8faa4330-07bb-4b65-810a-bbce29d3cd42>;
    smtg:rulingText "If the copied permanent is copying something else, then the token enters the battlefield as whatever that permanent copied.";
    smtg:publishedOn "2023-04-14"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
