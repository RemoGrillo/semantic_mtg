    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/562d71b9-1646-474e-9293-55da6947a758/1864cc548e4e> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/562d71b9-1646-474e-9293-55da6947a758>;
    smtg:rulingText "If X is 0 for Agadeem's Awakening, you can target one creature card with mana value 0.";
    smtg:publishedOn "2020-09-25"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
