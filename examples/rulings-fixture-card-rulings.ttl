    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/8faa4330-07bb-4b65-810a-bbce29d3cd42>;
    smtg:rulingText "If the spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.";
