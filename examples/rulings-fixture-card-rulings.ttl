    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57>;
    smtg:rulingText "Valki copies the printed values of the exiled creature card. Notably, once Valki becomes a copy of another creature card, he won't have his own printed activated ability.";
    smtg:publishedOn "2021-02-05"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57/aa97895c4fa4> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57>;
    smtg:rulingText "While resolving Tibalt's last ability, you'll add {R}{R}{R} even if you don't exile any cards.";
    smtg:publishedOn "2021-02-05"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57/0888a8424e9a> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57>;
    smtg:rulingText "You can activate Valki's ability multiple times in response to one another. This may briefly allow Valki to copy different creature cards. You'll get priority to cast spells or activate abilities in between each of Valki's activated abilities.";
    smtg:publishedOn "2021-02-05"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57/9ac6e1002863> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/907ae517-22d5-4ac7-bc3a-3f4d5eaeeb57>;
    smtg:rulingText "You don't choose which creature card exiled with Valki that Valki will become a copy of until that ability is resolving. (In many cases, the value you chose for X will give away your intentions.)";
    smtg:publishedOn "2021-02-05"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/da9ece8ebe8e> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "Although originally printed with a characteristic-defining ability that defined its color, this card now has a color indicator. This color indicator can't be affected by text-changing effects (such as the one created by Crystal Spray), although color-changing effects can still overwrite it.";
    smtg:publishedOn "2013-06-07"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/fd3627703912> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "A card with no mana cost can't be cast normally; you'll need a way to cast it for an alternative cost or without paying its mana cost, such as by suspending it.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/6d5ce4b3cf0c> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "Cards exiled with suspend are exiled face up.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/d6f555131465> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "Due to a recent rules change to suspend, you are no longer required to cast the suspended card as the second triggered ability of suspend resolves. Instead, as the second triggered ability resolves, you may cast the card. Timing permissions based on the card's type are ignored. If you don't cast the card, it remains exiled with no time counters on it, and it's no longer suspended.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/1b72de6bad89> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "Exiling a card with suspend isn't casting that card. This action doesn't use the stack and can't be responded to.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/28934724cd87> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If a card with no mana cost is given an alternative cost equal to its mana cost (by Snapcaster Mage, for example), that cost cannot be paid and the card cannot be cast this way.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/f8987c197ed8> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If an effect refers to a \"suspended card,\" that means a card that (1) has suspend, (2) is in exile, and (3) has one or more time counters on it.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/315e63d66818> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If the card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/27845090bc4b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If the first triggered ability of suspend (the one that removes time counters) is countered, no time counter is removed. The ability will trigger again at the beginning of the card's owner's next upkeep.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/d6a1b90cb5b4> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If the second triggered ability is countered, the card can't be cast. It remains exiled with no time counters on it, and it's no longer suspended.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/486e38e3636f> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If the spell requires any targets, those targets are chosen when the spell is finally cast, not when it's exiled.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/6be603de3aa1> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "If you cast a card \"without paying its mana cost,\" such as with suspend, you can't choose to cast it for any alternative costs. You can, however, pay additional costs. If the card has any mandatory additional costs, you must pay those if you want to cast the card.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/13e5d9ade663> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "Suspend is a keyword that represents three abilities. The first is a static ability that allows you to exile the card from your hand with the specified number of time counters (the number before the dash) on it by paying its suspend cost (listed after the dash). The second is a triggered ability that removes a time counter from the suspended card at the beginning of each of your upkeeps. The third is a triggered ability that gives you the option to cast the card when the last time counter is removed.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/e52193c76795> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "The mana value of a spell cast without paying its mana cost is determined by its mana cost, even though that cost wasn't paid.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/e8e247278b92> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "When the last time counter is removed, the second triggered ability of suspend (the one that lets you cast the card) triggers. It doesn't matter why the last time counter was removed or what effect removed it.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/9728dec9-d482-4c7a-8cdc-44d010dc878d/d89a1bfd571a> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/9728dec9-d482-4c7a-8cdc-44d010dc878d>;
    smtg:rulingText "You can exile a card in your hand using suspend any time you could cast that card. Consider its card type, any effects that modify when you could cast it (such as flash) and any other effects that stop you from casting it (such as from Meddling Mage's ability) to determine if and when you can do this. Whether you could actually complete all steps in casting the card is irrelevant. For example, you can exile a card with suspend that has no mana cost or that requires a target even if no legal targets are available at that time.";
    smtg:publishedOn "2024-02-02"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/f324c1d889e0> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "A split card's characteristics are a combination of its two halves while it is not on the stack. For example, Assault // Battery has a mana value of 5 while it is in your library. If an effect allows you to search your library for a card with mana value 4 or less, you can't find Assault // Battery.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/bfce8106552d> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "Each split card has two names. If an effect instructs you to choose a card name, you may choose one of those names, but not both.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/8df1af931034> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "Each split card is a single card. For example, if you discard a split card, you've discarded one card, not two. If an effect counts the number of sorcery cards in your graveyard, Assault // Battery counts once, not twice.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/a1b3a21dc821> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "If an effect allows you to cast a spell with certain characteristics, consider only the characteristics of the half you're casting. For example, if an effect allows you to cast a sorcery spell with mana value 2 or less from among cards in your graveyard, you could cast Assault this way, but not Battery.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/1b23df0a1907> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "If you copy a spell that's half of a split card, the copy copies that same half. For example, if you copy Assault, the copy is also Assault, not Battery.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/04c2810301b9> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "Split cards have two card faces on a single card. The characteristics of the half you didn't cast are ignored while the spell is on the stack.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/ae92942b-919c-4ea9-b693-85fcef765d5a/dfef5fc5d393> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/ae92942b-919c-4ea9-b693-85fcef765d5a>;
    smtg:rulingText "To cast a split card, choose one of its halves to cast. There's no way to cast both halves of this split card.";
    smtg:publishedOn "2022-12-08"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3/0482a46188e8> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3>;
    smtg:rulingText "Ghalta's first ability can't reduce its cost below {G}{G}.";
    smtg:publishedOn "2018-01-19"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3/7c20cb4b7bb4> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3>;
    smtg:rulingText "If a creature's power is somehow less than 0, it subtracts from the total power of your other creatures. If the total power of your creatures is 0 or less, Ghalta's cost remains {10}{G}{G}.";
    smtg:publishedOn "2018-01-19"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3/e8e769fc884b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3>;
    smtg:rulingText "The total cost to cast Ghalta is locked in before you pay that cost. For example, if you control three 2/2 creatures, including one you can sacrifice to add {C}, the total cost of Ghalta is {4}{G}{G}. Then you can sacrifice the creature when you activate mana abilities just before paying the cost.";
    smtg:publishedOn "2018-01-19"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3/866cc8231dcf> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/b0b6be0c-41cf-4757-9f0e-87227b6ba6b3>;
    smtg:rulingText "To determine Ghalta's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases, then apply any cost reductions. Ghalta's mana value remains unchanged, no matter what the total cost to cast it was.";
    smtg:publishedOn "2018-01-19"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/b23587e0-9fb7-492e-8bb4-f218e8e4ce6c/0f2c27b1d29b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/b23587e0-9fb7-492e-8bb4-f218e8e4ce6c>;
    smtg:rulingText "For more information on meld cards, see the Eldritch Moon mechanics article (https://magic.wizards.com/en/articles/archive/feature/eldritch-moon-mechanics-2016-06-27).";
    smtg:publishedOn "2016-07-13"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/bce7e45d-b2c5-43aa-91a6-3a3c24f30850/0f2c27b1d29b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/bce7e45d-b2c5-43aa-91a6-3a3c24f30850>;
    smtg:rulingText "For more information on meld cards, see the Eldritch Moon mechanics article (https://magic.wizards.com/en/articles/archive/feature/eldritch-moon-mechanics-2016-06-27).";
    smtg:publishedOn "2016-07-13"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/43500e1e5b87> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "An adventurer card is a permanent card in every zone except the stack, as well as while on the stack if not cast as an Adventure. Ignore its alternative characteristics in those cases. For example, while it's in your graveyard, Giant Killer is a white creature card whose mana value is 1. It can't be the target of the triggered ability of Mystic Sanctuary.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/ea7b23d58fa3> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "Bonecrusher Giant's ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/7f6d8eaab3b2> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "Casting a card as an Adventure isn't casting it for an alternative cost. Effects that allow you to cast a spell for an alternative cost or without paying its mana cost may allow you to apply those to the Adventure.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/755af665a9e3> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If a spell is cast as an Adventure, its controller exiles it instead of putting it into its owner's graveyard as it resolves. For as long as it remains exiled, that player may cast it as a permanent spell. If an Adventure spell leaves the stack in any way other than resolving (most likely by being countered or by failing to resolve because its targets have all become illegal), that card won't be exiled and the spell's controller won't be able to cast it as a permanent later.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/bf5a386d227c> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If a spell targets Bonecrusher Giant more than once, its ability triggers only once.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/ec4a9884305b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If an adventurer card ends up in exile for any other reason than by exiling itself while resolving, it won't give you permission to cast it as a permanent spell.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/48889a7bf69e> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If an effect copies an Adventure spell, that copy is exiled as it resolves. It ceases to exist as a state-based action; it's not possible to cast the copy as a permanent.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/85454734699a> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If an effect instructs you to choose a card name, you may choose the alternative Adventure name. Consider only the alternative characteristics to determine whether that is an appropriate name to choose.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/f30bd51202ca> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If an object becomes a copy of an object that has an Adventure, the copy also has an Adventure. If it changes zones, it will either cease to exist (if it's a token) or cease to be a copy (if it's a nontoken permanent), and so you won't be able to cast it as an Adventure.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
    smtg:observedIn <https://w3id.org/smtg/id/snapshot/scryfall-rulings-91f484351c00>;
    smtg:hasEpistemicStatus <https://w3id.org/smtg/vocab/epistemic-status/authoritative-report>;
    smtg:hasAttitude <https://w3id.org/smtg/vocab/attitude/knowledge-claim>;
    smtg:hasLifecycleStatus <https://w3id.org/smtg/vocab/claim-lifecycle/current>.
<https://w3id.org/smtg/id/claim/ruling/d6d72f5f-8f5d-4180-b514-f22ff5482902/97805f5b182b> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/d6d72f5f-8f5d-4180-b514-f22ff5482902>;
    smtg:rulingText "If the chosen target is an illegal target by the time Stomp tries to resolve, the spell won't resolve. Damage can be prevented as usual.";
    smtg:publishedOn "2019-10-04"^^xsd:date;
    smtg:claimedBy <https://w3id.org/smtg/id/agent/wizards>;
