<https://w3id.org/smtg/id/claim/ruling/8faa4330-07bb-4b65-810a-bbce29d3cd42/63d8e9953e24> a smtg:Ruling;
    smtg:rulingFor <https://w3id.org/smtg/id/oracle-card/8faa4330-07bb-4b65-810a-bbce29d3cd42>;
    smtg:rulingText "Any enters-the-battlefield abilities of the copied permanent will trigger when the token enters the battlefield. Any \"as [this permanent] enters the battlefield\" or \"[this permanent] enters the battlefield with\" abilities of the copied permanent will also work.";
    smtg:publishedOn "2023-04-14"^^xsd:date;
